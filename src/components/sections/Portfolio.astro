---
import Eyebrow from "../ui/Eyebrow.astro";

const tattoos = [
    { alt: "Placeholder 1", size: "large" },
    { alt: "Placeholder 2", size: "small" },
    { alt: "Placeholder 3", size: "small" },
    { alt: "Placeholder 4", size: "large" },
    { alt: "Placeholder 5", size: "small" },
    { alt: "Placeholder 6", size: "small" },
];
---

<section id="portfolio" class="portfolio theme-light">
    <div class="portfolio_inner">
        <Eyebrow>Portfolio</Eyebrow>

        <h2 class="portfolio_title">Mach' dir selbst ein Bild</h2>
        <ul class="portfolio_grid">
            {tattoos.map((tattoo) => (
                <li class={`portfolio_item portfolio_item--${tattoo.size}`}>
                    <span class="portfolio_placeholder">{tattoo.alt}</span>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .portfolio {
        scroll-margin-top: var(--header-height);
    }

    .portfolio_inner {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-inline: var(--space-md);
    }

    .portfolio_title {
        margin-top: var(--space-md);
        font-size: var(--text-2xl);
    }

    .portfolio_grid {
        list-style: none;
        padding: 0;
        margin-top: var(--space-xl);

        display: grid;
        grid-template-columns: repeat(2, 1fr);   /* Handy: 2 Spalten */


        gap: 3px;
}

    .portfolio_item {
        min-width: 0;
        aspect-ratio: 1 / 1.3;     /* quadratische Kacheln */
    }

    .portfolio_item--large {
        grid-column: 1 / -1;
        aspect-ratio: 1 / 1.3;
    }

    /* Nur für die Platzhalter – fliegt raus, sobald echte Bilder da sind */
    .portfolio_placeholder {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        padding: var(--space-sm);
        text-align: center;
        color: var(--color-text-muted);
        background-color: var(--color-surface-alt);
    }
</style>