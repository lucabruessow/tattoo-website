---
// src/components/sections/Faq.astro
import Eyebrow from "../ui/Eyebrow.astro";
import { faqs } from "../../data/faq";
---

<section id="faq" class="faq">
  <div class="faq_inner">
    <Eyebrow>FAQ</Eyebrow>
    <h2 class="faq_title">Häufige Fragen</h2>

    <ul class="faq_list">
      {faqs.map((faq) => (
        <li>
          <details class="faq_item">
            <summary class="faq_question">{faq.question}</summary>
            <p class="faq_answer">{faq.answer}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
    .faq {
    scroll-margin-top: var(--header-height);
    }

    .faq_inner {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-inline: var(--space-md);
    }

    .faq_title {
        margin-top: var(--space-md);
        font-size: var(--text-2xl);
    }

    .faq_list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-xl);
    }

    summary {
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .faq_question {
        font-size: var(--text-lg);
        font-weight: var(--weight-bold);
        margin-bottom: 1rem;
    }

    .faq_answer {
        margin-bottom: 2rem;
    }
</style>