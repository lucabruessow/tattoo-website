---
// src/components/sections/Faq.astro
import Eyebrow from "../ui/Eyebrow.astro";
import { faqs } from "../../data/faq";
---

<section id="faq" class="faq">
  <div class="faq_inner">
    <Eyebrow>FAQ</Eyebrow>
    <h2 class="faq_title">Häufige Fragen</h2>

    <ul class="faq_list">
      {faqs.map((faq) => (
        <li>
          <details class="faq_item">
            <summary class="faq_question">{faq.question}</summary>
            <p class="faq_answer">{faq.answer}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
    .faq {
    scroll-margin-top: var(--header-height);
    }

    .faq_inner {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-inline: var(--space-md);
    }

    .faq_title {
        margin-top: var(--space-md);
        font-size: var(--text-2xl);
    }

    .faq_list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-xl);
    }

    summary {
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .faq_question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        cursor: pointer;
        font-size: var(--text-lg);
        font-weight: var(--weight-bold);
        margin-bottom: 1rem;
        transition: var(--transition-slow);
    }

    .faq_question::after {
        content: "";
        flex: none;
        width: 0.5em;
        height: 0.5em;
        border-right: 3px solid var(--color-accent);
        border-bottom: 3px solid var(--color-accent);
        transform: translateY(-0.15em) rotate(45deg);
        transition: transform var(--transition-slow);
    }

    .faq_item[open] .faq_question::after {
        transform: translateY(0.15em) rotate(-135deg);
    }

    .faq_item[open] .faq_question {
        color: var(--color-accent);
    }

    .faq_answer {
        margin-bottom: 2rem;
        opacity: 0;
        transform: translateY(-0.75rem);
        transition:
            opacity var(--transition-slow),
            transform var(--transition-slow);
    }

    .faq_item[open] .faq_answer {
    opacity: 1;
    transform: translateY(0);
    }

    .faq_item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
        block-size var(--transition-slow),
        content-visibility var(--transition-slow);
        transition-behavior: allow-discrete;
    }

    .faq_item[open]::details-content {
        block-size: auto;
    }

    @media (prefers-reduced-motion: reduce) {
    .faq_question,
    .faq_question::after,
    .faq_item::details-content,
    .faq_answer {
        transition: none;
    }
}
</style>