---
const base = import.meta.env.BASE_URL;
const videoSrc = `${base}videos/placeholder-video.mp4`;
---
<section class="hero">
    <video class="hero_video" autoplay muted loop playsinline>
        <source src={videoSrc} type="video/mp4" />
    </video>

    <div class="hero_content">
        <div class="hero_content_text">
            <h1 class="hero_title">Arne Kellermann</h1>
            <p class="hero_tagline">Illustrative & Custom Tattoos</p>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        height: 100svh;
        overflow: hidden;
    }

    .hero_video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
        z-index: 0;
    }

    .hero_content {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        text-align: center;
        font-size: var(--text-lg);
        color: var(--color-text);
        background-color: rgba(0, 0, 0, 0.4);
        padding: var(--space-lg);
    }
    .hero_content .hero_tagline {
        font-size: var(--text-lg);
    }
</style>