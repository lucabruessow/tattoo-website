---
const base = import.meta.env.BASE_URL;

// id = die id der Section, zu der der Link springt
const navItems = [
    { id: "about", label: "About" },
    { id: "portfolio", label: "Portfolio" },
    { id: "faq", label: "FAQ" },
    { id: "contact", label: "Contact" },
];
---
<header class="main-header">
    <nav id="nav" class="main-nav">

        <a href={`${base}/#top`} class="brand" aria-label="Zum Seitenanfang"></a>

        <ul class="nav-links">
            {navItems.map((item) => (
                <li class="nav-item">
                    <a href={`${base}/#${item.id}`} class="nav-link">{item.label}</a>
                </li>
            ))}
        </ul>

        <button class="burger-menu" aria-label="Menü" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </nav>
</header>

<script>
    const burger = document.querySelector(".burger-menu");
    const links = document.querySelector(".nav-links");

    // Menü auf- oder zumachen - an einer Stelle, damit alles zusammenpasst
    const setMenu = (open: boolean) => {
        burger?.classList.toggle("menu-open", open);
        links?.classList.toggle("menu-open", open);
        burger?.setAttribute("aria-expanded", String(open));
    };

    burger?.addEventListener("click", () => {
        setMenu(!links?.classList.contains("menu-open"));
    });

    // Klick auf einen Link: Menü zu, der Browser springt dann zum Abschnitt
    links?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) setMenu(false);
    });
</script>

<style>
    .main-header {
        position: fixed;
        z-index: 1001;
        width: 100%;
        height: var(--header-height);
        box-sizing: border-box;
        background-color: transparent;
        transition: var(--transition-slow);
    }

    .main-header.is-hidden {
        transform: translateY(-100%)
    }

    .brand {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: var(--weight-bold);
        color: var(--color-text);
        z-index: 1001;
    }

    ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
        background-color: var(--color-overlay-dark);
    }

    .main-nav {
        height: 100%;
        display: flex;
        justify-content: space-between;
        padding: 0 var(--space-md);
        align-items: center;
        border: none;
    }

    .burger-menu {
        background-color: transparent;
        display: block;
        border: none;
        padding: var(--space-xs);
        cursor: pointer;
        z-index: 1001;
        transition: scale var(--transition);
    }

    .burger-menu:hover {
        scale: 1.1;
    }

    .burger-menu span {
        display: block;
        width: 28px;
        height: 3px;
        margin: 5px 0;
        background: var(--color-accent);
        border: none;
        transition: background var(--transition), transform var(--transition);
        filter: drop-shadow(0 0 3px rgb(0 0 0 / 0.3))
    }

    .burger-menu:hover span{
        background: var(--color-accent-hover);
    }

    .burger-menu.menu-open span:nth-child(2) {
        opacity: 0;
        visibility: hidden;
    }
    .burger-menu.menu-open span:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }
    .burger-menu.menu-open span:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    .nav-links {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: var(--space-lg);

        background-color: var(--color-overlay-dark);

        visibility: hidden;
        opacity: 0;
        transition: var(--transition);
        z-index: 1000;
    }

    .nav-item {
        margin: var(--space-sm) 0;
    }

    .nav-link {
        font-size: var(--text-lg);
    }

    .nav-links.menu-open {
        visibility: visible;
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .burger-menu:hover { scale: 1; }
    }
</style>