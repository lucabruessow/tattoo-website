---
---
<header class="main-header">
    <nav id="nav" class="main-nav">

        <a href="tattoo-website/#hero" class="brand"></a>

        <ul class="nav-links">
            <li class="nav-item"><a href="/#about" class="nav-link about">About</a></li>
            <li class="nav-item"><a href="/#portfolio" class="nav-link portfolio">Portfolio</a></li>
            <li class="nav-item"><a href="/#faq" class="nav-link faq">FAQ</a></li>
            <li class="nav-item"><a href="/#contact" class="nav-link contact">Contact</a></li>
        </ul>

        <button class="burger-menu" aria-label="Menü" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </nav>
</header>

<script>
    const burger = document.querySelector(".burger-menu");
    const links = document.querySelector(".nav-links");
    const header = document.querySelector(".main-header");


    burger?.addEventListener("click", () => {
        burger?.classList.toggle("menu-open");
        links?.classList.toggle("menu-open");
    })

    let lastY = window.scrollY;

    window.addEventListener("scroll", () => {
        if (links?.classList.contains("menu-open")) return;  // Menü offen → nichts tun

        const currentY = window.scrollY;

        if (currentY > lastY && currentY > 100) {
            header?.classList.add("is-hidden");      // runter → weg
        } else if (currentY < lastY) {
            header?.classList.remove("is-hidden");   // hoch → zeigen
        }

        lastY = currentY;
    }, { passive: true });

</script>

<style>
    .main-header {
        position: fixed;
        z-index: 1001;
        width: 100%;
        height: var(--header-height);
        box-sizing: border-box;
        background-color: transparent;
        transition: var(--transition-slow);
    }

    .main-header.is-hidden {
        transform: translateY(-100%)
    }

    .brand {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: var(--weight-bold);
        color: var(--color-text);
        z-index: 1001;
    }

    ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
        background-color: var(--color-overlay-dark);
    }

    .main-nav {
        height: 100%;
        display: flex;
        justify-content: space-between;
        padding: 0 var(--space-md);
        align-items: center;
        border: none;
    }

    .burger-menu {
        background-color: transparent;
        display: block;
        border: none;
        padding: var(--space-xs);
        cursor: pointer;
        z-index: 1001;
        transition: scale var(--transition);
    }

    .burger-menu:hover {
        scale: 1.1;
    }

    .burger-menu span {
        display: block;
        width: 28px;
        height: 3px;
        margin: 5px 0;
        background: var(--color-accent);
        border: none;
        transition: background var(--transition), transform var(--transition);
        filter: drop-shadow(0 0 3px rgb(0 0 0 / 0.3))
    }

    .burger-menu:hover span{
        background: var(--color-accent-hover);
    }

    .burger-menu.menu-open span:nth-child(2) {
        opacity: 0;
        visibility: hidden;
    }
    .burger-menu.menu-open span:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }
    .burger-menu.menu-open span:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    .nav-links {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: var(--space-lg);

        background-color: var(--color-overlay-dark);

        visibility: hidden;
        opacity: 0;
        transition: var(--transition);
        z-index: 1000;
    }

    .nav-item {
        margin: var(--space-sm) 0;
    }

    .nav-links.menu-open {
        visibility: visible;
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .burger-menu:hover { scale: 1; }
    }
</style>