---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
    /** "button" = echter Button.
        "span"  = sieht aus wie ein Button, ist aber keiner.
        Braucht man, wenn er in einem anderen Button oder Link steckt. */
    as?: "button" | "span";
    variant?: "accent" | "frosted"
}

// ...attrs = alle übrigen Attribute (z. B. aria-pressed, data-*), landen auf dem <button>
const { as = "button", variant = "accent", ...attrs }: Props = Astro.props;

const variants = {
    accent: {
        btnBg: "var(--color-accent)",
        btnBgHover: "var(--color-accent-hover)",
        btnBorder: "1px solid color-mix(in srgb, var(--color-accent) 25%, transparent)"
    },
    frosted: {
        btnBg: "var(--color-frosted)",
        btnBgHover: "color-mix(in srgb, var(--c-neutral-100) 30%, transparent)",
        btnBorder: "1px solid color-mix(in srgb, var(--color-frosted) 30%, transparent)"
    }
}

const btnVars = variants[variant]
---

{as === "span" ? (
    <span class="btn"><slot>Book on Instagram</slot></span>
) : (
    <button type="button" class="btn" {...attrs}><slot>Book on Instagram</slot></button>
)}

<style define:vars= { btnVars }>
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.5em 1em;
        border-radius: 0.75em;
        line-height: 1.4;
        border: var(--btnBorder);
        background-color: var(--btnBg);
        backdrop-filter: blur(6px);
        color: var(--c-neutral-50);
        white-space: nowrap;
        cursor: pointer;
        transition: background-color var(--transition);
    }

    .btn:hover {
        background-color: var(--btnBgHover);
    }

    /* Umschalt-Button, der gerade nicht gewählt ist: nur Rahmen */
    .btn[aria-pressed="false"] {
        border-color: currentColor;
        background-color: transparent;
        color: var(--color-text);
    }

    .btn[aria-pressed="false"]:hover {
        background-color: color-mix(in srgb, currentColor 10%, transparent);
    }
</style>