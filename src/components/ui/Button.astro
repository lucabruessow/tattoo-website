---
interface Props {
    /** "button" = echter Button.
        "span"  = sieht aus wie ein Button, ist aber keiner.
        Braucht man, wenn er in einem anderen Button oder Link steckt. */
    as?: "button" | "span";
    variant?: "accent" | "frosted"
}

const { as = "button", variant = "accent" }: Props = Astro.props;

const variants = {
    accent: {
        btnBg: "var(--color-accent)",
        btnBgHover: "var(--color-accent-hover)",
        btnBorder: "1px solid color-mix(in srgb, var(--color-accent) 25%, transparent)"
    },
    frosted: {
        btnBg: "var(--color-frosted)",
        btnBgHover: "color-mix(in srgb, var(--c-neutral-100) 30%, transparent)",
        btnBorder: "1px solid color-mix(in srgb, var(--color-frosted) 30%, transparent)"
    }
}

const btnVars = variants[variant]
---

{as === "span" ? (
    <span class="btn"><slot>Book on Instagram</slot></span>
) : (
    <button type="button" class="btn"><slot>Book on Instagram</slot></button>
)}

<style define:vars= { btnVars }>
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.5em 1em;
        border-radius: 0.75em;
        line-height: 1.4;
        border: var(--btnBorder);
        background-color: var(--btnBg);
        backdrop-filter: blur(6px);
        color: var(--c-neutral-50);
        white-space: nowrap;
        cursor: pointer;
        transition: background-color var(--transition);
    }

    .btn:hover {
        background-color: var(--btnBgHover);
    }
</style>